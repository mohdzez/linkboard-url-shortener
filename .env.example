# =============================================================================
# Local development env (used by docker-compose.yml). Copy to .env to override.
#
# On Liftoff these values are NOT set by hand — they are AUTO-INJECTED when you
# draw connection edges on the canvas (DATABASE_URL, REDIS_URL, SPACES_*,
# API_URL), except the SECRET vault values (SESSION_SECRET, SPACES_KEY/SECRET).
# =============================================================================

# Postgres  (injected by a Postgres -> service connection on the canvas)
DATABASE_URL=postgres://linkboard:linkboard@postgres:5432/linkboard

# Redis     (injected by a Redis -> service connection on the canvas)
REDIS_URL=redis://redis:6379

# Spaces / S3 bucket identity (injected by a Spaces -> service connection)
SPACES_BUCKET=linkboard
SPACES_ENDPOINT=http://minio:9000
SPACES_REGION=us-east-1

# Spaces access keys — SECRETS you set in the Liftoff vault (here = MinIO creds)
SPACES_KEY=minioadmin
SPACES_SECRET=minioadmin

# Service-link URL (injected by a web -> api connection on the canvas)
API_URL=http://api:3000

# App secret (a SECRET vault var)
SESSION_SECRET=dev-only-change-me

# Misc
NODE_ENV=development
LOG_LEVEL=info
PRUNE_DAYS=30
